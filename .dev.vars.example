# Never commit .dev.vars or actual secret values. Demo needs no secrets.
APP_MODE=demo
# Live uses email/password sessions by default.
# AUTH_MODE=password
# ADMIN_SETUP_TOKEN= (random 24+ characters, setup only)
# For optional Access authentication set AUTH_MODE=access.
